# GEMINI_API_KEY: Disediakan otomatis oleh sistem AI Studio (jika diperlukan)
GEMINI_API_KEY=""

# APP_URL: URL hosting aplikasi (disediakan otomatis oleh lingkungan runtime)
APP_URL=""

# ==============================================================================
# KONFIGURASI APLIKASI - FIREBASE FIRESTORE & AUTHENTICATION
# Database menggunakan Google Firebase Firestore (Cloud Database)
# Autentikasi administrator menggunakan Firebase Authentication.
# CATATAN PENTING:
# DATABASE_URL dan JWT_SECRET TIDAK LAGI DIPERLUKAN karena database dan autentikasi
# telah dikonfigurasi menggunakan Firebase Firestore & Firebase Auth melalui
# firebase-applet-config.json yang terkelola secara aman.
# ==============================================================================

# API_URL (Opsional)
# Endpoint URL API backend untuk klien. Bawaan adalah relative path "/api".
API_URL="/api"
